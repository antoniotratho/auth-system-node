# ============================================
# CONFIGURAÇÕES BÁSICAS
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL=mysql://root:password@localhost:3306/auth_system

# ============================================
# AUTENTICAÇÃO E SEGURANÇA
# ============================================
# JWT Secret - MUDE ISSO EM PRODUÇÃO! Mínimo 32 caracteres
JWT_SECRET=sua-chave-secreta-muito-segura-aqui-com-32-caracteres-min

# Tempo de expiração do JWT (ex: 1h, 24h, 7d)
JWT_EXPIRATION=1h

# ============================================
# CORS - Domínios permitidos
# ============================================
# Separe múltiplos domínios por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
# Use "app password" no Gmail, não sua senha real!
SMTP_PASS=sua-senha-app-aqui
SMTP_FROM=noreply@seudominio.com

# ============================================
# RATE LIMITING
# ============================================
# Janela de tempo em milissegundos
RATE_LIMIT_WINDOW_MS=900000
# Máximo de requisições por janela
RATE_LIMIT_MAX_REQUESTS=100
# Rate limit específico para login
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5

# ============================================
# CRIPTOGRAFIA DE DADOS (PARA IMPLEMENTAÇÃO FUTURA)
# ============================================
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=seu-encryption-key-em-base64-aqui

# ============================================
# REDIS (PARA CACHE E BLACKLIST - OPCIONAL)
# ============================================
# REDIS_URL=redis://localhost:6379

# ============================================
# LGPD - RETENÇÃO DE DADOS
# ============================================
# Quantos dias manter logs/dados deletados
DATA_RETENTION_DAYS=365

# ============================================
# LOG
# ============================================
LOG_LEVEL=info
